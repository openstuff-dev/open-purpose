# Copy to .env and adjust. docker compose reads it automatically.

# Password for the bundled Postgres. Change it before the first start: the
# database is created with it and keeps it afterwards.
POSTGRES_PASSWORD=change-me

# First organization, created on first boot only. The group defaults to the
# same name and stays hidden until it has a second organization.
OPENPURPOSE_GROUP_NAME=
OPENPURPOSE_ORG_NAME=Our company

# Address people and agents reach the server at; shown in MCP setup snippets.
OPENPURPOSE_PUBLIC_URL=http://localhost:8080

# Optional: fix the first admin's token instead of reading it from the log.
OPENPURPOSE_BOOTSTRAP_TOKEN=

# Behind a reverse proxy: the proxy's addresses (10.0.0.0/8,127.0.0.1), so rate
# limits see each visitor's address. true trusts anyone who can reach the server,
# which lets them fake their address. Leave empty without a proxy.
OPENPURPOSE_TRUST_PROXY=

# API specs linked by URL are fetched by the server, but never from private
# network addresses (localhost, 10.x, 172.16-31.x, 192.168.x, Docker service
# names, ...), so a link can't be used to probe your network. If your specs live
# on your own network, list those hosts here, comma separated: names, addresses
# or ranges, e.g. billing-api,192.168.1.20,10.0.0.0/8. Public URLs need nothing.
OPENPURPOSE_API_FETCH_ALLOW=
# off: never fetch spec URLs; people upload spec files instead.
OPENPURPOSE_API_FETCH=on

# Optional: sign-in by email link and GitHub through Supabase, and sign-up.
# See "Sign-up and sign-in" in the README. Empty = access tokens only.
OPENPURPOSE_AUTH_PROVIDER=
OPENPURPOSE_SUPABASE_URL=
OPENPURPOSE_SUPABASE_KEY=
# off: no sign-up · approval: an admin approves new people · open: anyone gets a workspace
OPENPURPOSE_SIGNUP=off
# Your public website, linked from the sign-in page.
OPENPURPOSE_SITE_URL=
