# Copy to .env and adjust. docker compose reads it automatically.

# Password for the bundled Postgres. Change it before the first start: the
# database is created with it and keeps it afterwards.
POSTGRES_PASSWORD=change-me

# First organization, created on first boot only. The group defaults to the
# same name and stays hidden until it has a second organization.
OPENPURPOSE_GROUP_NAME=
OPENPURPOSE_ORG_NAME=Our company

# Address people and agents reach the server at; shown in MCP setup snippets.
OPENPURPOSE_PUBLIC_URL=http://localhost:8080

# Optional: fix the first admin's token instead of reading it from the log.
OPENPURPOSE_BOOTSTRAP_TOKEN=
