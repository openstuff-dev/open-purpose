# Copy to .env next to docker-compose.home.yml, then: chmod 600 .env
# Keep a copy in your password manager: with it, the stack starts on any machine.

# So that plain `docker compose ...` uses the home file.
COMPOSE_FILE=docker-compose.home.yml

# Which release to run. Roll back by setting the previous one and running `docker compose up -d`.
OPENPURPOSE_IMAGE_TAG=0.3.6

# Supabase › Connect › Session pooler (port 5432 on pooler.supabase.com). Not the transaction
# pooler (6543) and not the direct connection. URL-encode special characters in the password.
DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

OPENPURPOSE_PUBLIC_URL=https://purpose.openstuff.app
OPENPURPOSE_SITE_URL=https://purpose.openstuff.dev
OPENPURPOSE_ORG_NAME=OpenStuff

# The first admin's token, used once on first boot. Generate it with: openssl rand -hex 32
# After the first sign-in, create a new token for yourself and clear this.
OPENPURPOSE_BOOTSTRAP_TOKEN=

# Sign-in by email link and GitHub. Supabase › Project Settings › API Keys.
OPENPURPOSE_AUTH_PROVIDER=supabase
OPENPURPOSE_SUPABASE_URL=https://<project-ref>.supabase.co
OPENPURPOSE_SUPABASE_KEY=sb_publishable_...
# off, approval or open
OPENPURPOSE_SIGNUP=approval

# API specs linked by URL are never fetched from private network addresses (localhost, 10.x,
# 172.16-31.x, 192.168.x, Docker service names, ...), so a link can't probe this network. If
# some of your specs live on your own network, list those hosts, comma separated: names,
# addresses or ranges, e.g. billing-api,192.168.1.20,10.0.0.0/8. Public URLs need nothing.
OPENPURPOSE_API_FETCH_ALLOW=

# The stack's Docker network: the first three numbers of a /24 that no other Docker network on
# this machine overlaps (the wizard picks one). cloudflared gets .2, the only trusted proxy.
OPENPURPOSE_NETWORK=172.30.47

# Cloudflare Zero Trust › Networks › Tunnels › your tunnel › the token in the install command.
TUNNEL_TOKEN=

# Backups go to ./backups. BACKUP_USER owns those files: your user and group ids (`id -u`, `id -g`).
BACKUP_USER=1000:1000
BACKUP_HOUR=3
BACKUP_KEEP_DAYS=14
TZ=Europe/Berlin
# Optional: a heartbeat URL (Healthchecks.io, Better Stack). It gets a request after each
# backup, and <url>/fail when one fails.
BACKUP_PING_URL=

# Optional: also copy every backup to Cloudflare R2. R2 › Manage API tokens › an "Object Read &
# Write" token for this one bucket.
R2_BUCKET=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
